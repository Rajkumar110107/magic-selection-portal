# ==============================================================================
# MAGIC SELECTION PORTAL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local (or configure these variables in your hosting dashboard).
# DO NOT commit real secrets, production credentials, or live passwords to Git.
# ==============================================================================

# 1. DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production Deployment (PostgreSQL - e.g., Supabase, Neon, Railway, Render, RDS):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/[YOUR-DB]?sslmode=require"

# 2. NEXTAUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Generate a secure 32+ byte string using: openssl rand -base64 32
AUTH_SECRET="your-32-character-random-auth-secret-key-here"

# Canonical Production URL (Required for production deployments on custom domains / Vercel):
# NEXTAUTH_URL="https://your-domain.com"

# 3. INITIAL ADMIN SEED CREDENTIALS
# ------------------------------------------------------------------------------
# Used when running 'npm run seed' to provision the administrator account.
ADMIN_EMAIL="admin@magic.com"
ADMIN_PASSWORD="your-strong-production-admin-password"

# 4. CANDIDATE SEED CREDENTIALS
# ------------------------------------------------------------------------------
# Initial password assigned to the 7 candidate accounts during 'npm run seed'.
CANDIDATE_DEFAULT_PASSWORD="your-initial-candidate-passcode"

# 5. DEMO SANDBOX CREDENTIALS (OPTIONAL)
# ------------------------------------------------------------------------------
# Passcode for the isolated 'TEST001' Demo Student account ('npm run seed:demo').
DEMO_STUDENT_PASSWORD="your-temporary-demo-passcode"
